{
  "name": "hexagonal-tdd-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.11.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "greet": "pnpm --filter @app/cli start",
    "eject:example": "node scripts/eject-example.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:diff": "node scripts/mutation-diff.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "check:arch": "sheriff verify",
    "check:dead": "knip",
    "check:dup": "jscpd packages",
    "gate": "pnpm run \"/^(typecheck|check|check:arch|test:coverage|check:dead|check:dup)$/\"",
    "prepare": "husky",
    "modules:hint": "node scripts/modules-hint.ts",
    "arch:map": "node scripts/arch-map.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@softarc/sheriff-core": "^0.19.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.0.4",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.6",
    "knip": "^6.16.1",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.4"
  }
}
